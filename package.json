{
  "name": "playstyle",
  "version": "0.1.0",
  "private": true,
  "description": "Game recommendations from your taste profile, with reviews from players who share it.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "covers": "node server/lib/fetch-covers.js",
    "vercel-build": "node scripts/gen-session-key.mjs"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.23.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
