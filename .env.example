# Copy to .env and fill in before deploying.
PORT=3000
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
# Comma-separated origins allowed to make state-changing requests in production
ALLOWED_ORIGINS=http://localhost:3000

# The app talks to Supabase over HTTPS by default and needs NO configuration:
# the publishable key is committed because it is designed to be public, and
# access control is enforced by RLS policies in the database.
#
# Set BOTH of the following to use a direct Postgres connection instead.
# USE_POSTGRES is required on purpose: a DATABASE_URL left over from an
# earlier attempt once selected a connection the app could not open and took
# the whole deployment down.
# USE_POSTGRES=1
# Supabase: Project Settings -> Database -> Connection string -> URI.
# Use the *pooler* host (port 6543) on a serverless host -- a direct
# connection per container will exhaust the connection limit.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
