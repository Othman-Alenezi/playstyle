# Copy to .env and fill in before deploying.
PORT=3000
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
# Comma-separated origins allowed to make state-changing requests in production
ALLOWED_ORIGINS=http://localhost:3000

# Postgres connection string. Set it and the app uses Postgres; leave it unset
# and it uses a local SQLite file, which is the default for development.
# Supabase: Project Settings -> Database -> Connection string -> URI.
# Use the *pooler* host (port 6543) on a serverless host -- a direct
# connection per container will exhaust the connection limit.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
